# 忽略便携 Python 环境与压缩包 (走 GitHub Releases 分发)
/python_embeded/
*.7z*
*.zip
*.rar

# 忽略超过 100MB 的模型权重文件 (.pth)
/matanyone2/pretrained_models/*.pth
/rvm/models/*.pth
/birefnet/models/**/*.safetensors
